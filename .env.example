# =============================================
# MIFA LIFE SHOP — Variables d'environnement
# =============================================
# Copiez ce fichier en .env.local et remplissez vos valeurs

# --- Supabase (données ; l'authentification passe par Better Auth) ---
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_clé_anon_publique
SUPABASE_SERVICE_ROLE_KEY=votre_clé_service_role_privée

# --- Better Auth ---
# Connexion Postgres directe : Supabase → Project Settings → Database →
# Connection string (URI). SERVER ONLY, contient le mot de passe de la base.
DATABASE_URL=postgresql://postgres:mot_de_passe@db.votre-projet.supabase.co:5432/postgres
# Secret de signature des sessions — générez-le avec : openssl rand -base64 32
BETTER_AUTH_SECRET=votre_secret_32_octets

# --- Application ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Paiements (optionnel en développement) ---
# PAYDUNYA_MASTER_KEY=
# PAYDUNYA_PRIVATE_KEY=
# PAYDUNYA_TOKEN=

# --- E-mail : REQUIS en production ---
# Sans clé, les codes de connexion ne partent pas : l'auth échoue explicitement
# en production et se contente de journaliser le code en développement.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Mifa Life <no-reply@mifa.life>

# --- Notifications (optionnel) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# SENDGRID_API_KEY=
